{
  "mochaExplorer.cwd": "dashgit-web/test",
  "mochaExplorer.mochaPath": "dashgit-web/test/node_modules/mocha",
  "mochaExplorer.files": [
    "Test*.js",
    "test/**/*.js"
  ],
  "mochaExplorer.env": {
    "NODE_ENV": "test"
  },

  // oauth-exchange tests use node:test (extension connor4312.nodejs-testing), restricted to avoid the mocha tests
  "nodejs-testing.include": [
    "./oauth-exchange"
  ],

  "java.server.launchMode": "Standard",
  "java.project.sourcePaths": [
    "dashgit-updater"
  ]
}